APP_NAME="Bungong Kupula"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database MySQL/MariaDB (dikelola lewat phpMyAdmin).
# Buat database kosong dulu di phpMyAdmin (collation utf8mb4_unicode_ci), lalu isi di bawah.
# Laragon/XAMPP: user biasanya "root" dengan password kosong.
# Shared hosting: pakai nama database, user, dan password dari cPanel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bungong_kupula
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Kontak situs ----
KUPULA_WHATSAPP=6281200000000
KUPULA_EMAIL=halo@bungongkupula.id
KUPULA_INSTAGRAM=

VITE_APP_NAME="${APP_NAME}"

# ---- Admin (login di /admin) ----
# Buat hash dengan: php artisan admin:hash
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
